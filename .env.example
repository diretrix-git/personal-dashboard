# Root environment variables — copy to .env and fill in your values
# Individual .env.example files in /backend and /web contain the same
# variables scoped per side for clarity.

# ───────────────────────────── BACKEND ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clerk server-side secret key (never exposed to the browser)
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Allowed origin for CORS (should match the frontend dev URL)
CLIENT_ORIGIN=http://localhost:5173

# Resend email API key (https://resend.com/api-keys)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Personal Dashboard <onboarding@resend.dev>
# REMINDER_RECIPIENT_EMAIL is no longer needed — emails are fetched from Clerk

# Cron expression for the daily reminder job (default: 08:00)
REMINDER_CRON=0 8 * * *

# ───────────────────────────── FRONTEND (web) ───────────────────────────────
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Clerk publishable key (safe to expose to the browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backend API base URL used by the React app
VITE_API_BASE_URL=http://localhost:5000/api
