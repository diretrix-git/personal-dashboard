# Backend environment variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB (Atlas) ─────────────────────────────────────────────────────────
# Paste your Atlas connection string here
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Clerk (Backend) ─────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── CORS ────────────────────────────────────────────────────────────────────
# URL of the frontend (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# ── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Personal Dashboard <onboarding@resend.dev>
REMINDER_RECIPIENT_EMAIL=your-email@example.com

# ── Reminder Cron ───────────────────────────────────────────────────────────
# Cron expression for the daily reminder job (default: 08:00 every day)
REMINDER_CRON=0 8 * * *
